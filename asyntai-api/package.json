{
    "name": "directus-extension-asyntai-api",
    "version": "1.0.0",
    "description": "Server side companion for the Asyntai module. It forwards questions from the Data Studio to the Asyntai API.",
    "keywords": [
        "directus",
        "directus-extension",
        "directus-extension-endpoint",
        "asyntai",
        "ai",
        "chatbot"
    ],
    "homepage": "https://asyntai.com",
    "license": "MIT",
    "author": "Asyntai",
    "type": "module",
    "directus:extension": {
        "type": "endpoint",
        "path": "dist/index.js",
        "source": "src/index.js",
        "host": "^10.10.0",
        "sandbox": {
            "enabled": true,
            "requestedScopes": {
                "request": {
                    "methods": ["POST"],
                    "urls": ["https://asyntai.com/*"]
                }
            }
        }
    },
    "devDependencies": {
        "@directus/extensions-sdk": "^11.0.0"
    },
    "scripts": {
        "build": "directus-extension build"
    }
}
